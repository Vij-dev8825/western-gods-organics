node_modules/
frontend/dist/
backend/.env
.env

# Runtime data (JSON dev-mode database) — only the product seed is versioned
backend/data/*.json
!backend/data/products.json

# Uploaded banners are recreated from backend/seed-assets on boot
backend/uploads/

# Generated by scripts/export-whatsapp-catalog.js — regenerate on demand
backend/exports/

# Live WhatsApp session credentials (see utils/whatsappBaileys.js) — never commit
backend/whatsapp-auth/

*.log
boot.log
boot.err

# Local Claude Code tooling config (browser preview launch config)
.claude/
