# Firebase phone-auth web app config — public/non-secret values (safe to
# ship in the client bundle). Get these from Firebase Console → Project
# Settings → General → Your apps → Web app. The matching private service
# account credentials go in backend/.env instead — see backend/.env.example.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
