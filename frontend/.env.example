# Frontend build-time settings. Copy to .env and fill in before `npm run build`.
# Anything here is baked into the public bundle — never put a secret in this file.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Create the property at analytics.google.com (Admin -> Create -> Property ->
# Web data stream) and paste the ID here.
#
# Leave it empty and analytics is completely inert: no script is fetched and
# every tracking call is a no-op. The site works exactly as it does today.
# It also never loads for a visitor who chose "Only necessary" in the cookie
# bar, regardless of this value.
VITE_GA_MEASUREMENT_ID=
